# One deployment serves exactly one track: textual, coding, or multimodal.
AML_TRACK=textual

# Use a dedicated absolute directory. Do not point this at a MemPalace palace.
AML_DATA_DIR=E:\mempalace-aml-data

AML_HOST=0.0.0.0
AML_PORT=8000
AML_HEALTH_PATH=/health
AML_ADD_PATH=/add
AML_SEARCH_PATH=/search

# Required for the multimodal track. It is harmless but unnecessary otherwise.
MEMPALACE_EMBEDDINGGEMMA2_MODALITIES=text+vision

# Enable only after model weights have been downloaded and cached.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
